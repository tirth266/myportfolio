# Portfolio REST API — Environment Configuration
# Copy this file to .env and fill in your real values:   cp .env.example .env
#
# .env is listed in .gitignore, so it is NEVER committed to GitHub.
# Only this .env.example file is tracked. Never paste a real secret here.

PORT=5000

# Local MongoDB. For MongoDB Atlas use:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task_manager
MONGO_URI=mongodb://127.0.0.1:27017/task_manager

# Origin allowed by the CORS middleware (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# JWT_SECRET — used to sign and verify every JSON Web Token.
#
# Anyone who knows this value can forge a token for ANY user id and log in as
# them, so it must be long, random and private. It lives ONLY in .env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login token stays valid. The practical asks for 1 hour.
JWT_EXPIRES_IN=1h

# Practical 6 — Google Sign-In (optional, only needed if you use the
# "Sign in with Google" button).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
